---
import { uid } from '../../lib/uid';
interface Props {
  class?: string;
  sub?: boolean;
}
const { class: className, sub = true } = Astro.props;
const gid = uid('logo');
---

<span class:list={['logo', className]}>
  <svg class="logo__mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id={gid} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="#5a98ff"></stop>
        <stop offset="1" stop-color="#1c4fd8"></stop>
      </linearGradient>
    </defs>
    <rect width="32" height="32" rx="9" fill={`url(#${gid})`}></rect>
    <path d="M16 6.5l7 2.7v5.6c0 4.6-3 8.4-7 9.7-4-1.3-7-5.1-7-9.7V9.2z" fill="none" stroke="#fff" stroke-width="1.8" stroke-linejoin="round"></path>
    <path d="M18.6 12.4c-.6-.8-1.6-1.2-2.7-1.2-1.4 0-2.4.7-2.4 1.8 0 2.5 5.3 1.4 5.3 4.1 0 1.2-1.1 2-2.6 2-1.2 0-2.3-.5-2.9-1.4" fill="none" stroke="#fff" stroke-width="1.6" stroke-linecap="round"></path>
  </svg>
  <span class="logo__text">
    <span class="logo__name">SPEX</span>
    {sub && <span class="logo__sub">SIMPLUGELITE</span>}
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
  }
  .logo__mark {
    width: 34px;
    height: 34px;
    filter: drop-shadow(0 4px 18px rgba(47, 123, 255, 0.55));
  }
  .logo__text {
    display: grid;
    line-height: 1;
    gap: 0.28rem;
  }
  .logo__name {
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.24em;
    color: var(--white);
  }
  .logo__sub {
    font-size: 0.56rem;
    font-weight: 600;
    letter-spacing: 0.3em;
    color: var(--muted);
  }
</style>
